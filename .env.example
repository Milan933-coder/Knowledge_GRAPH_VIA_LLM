# auto = AICredits when AICREDITS_API_KEY exists, otherwise local Ollama
LLM_PROVIDER=auto

# AICredits OpenAI-compatible API
AICREDITS_API_KEY=
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_MODEL=openai/gpt-4o-mini

# Local model (no API key required)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

LLM_TEMPERATURE=0.1
LLM_MAX_NEW_TOKENS=768
LLM_TIMEOUT_SECONDS=120

# Optional Neo4j loading
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

